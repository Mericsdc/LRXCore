<Application x:Class="LRXCore.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LRXCore.ViewModels"
             xmlns:views="clr-namespace:LRXCore.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/ObsidianBlack.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InstallerViewModel}">
                <views:InstallerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TweaksViewModel}">
                <views:TweaksView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ServicesViewModel}">
                <views:ServicesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UninstallerViewModel}">
                <views:UninstallerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CleanerViewModel}">
                <views:CleanerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RegistryViewModel}">
                <views:RegistryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
                <views:UpdatesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
