<UserControl x:Class="LRXCore.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Windows Debloat, Gizlilik &amp; ShutUp10++ Önerileri" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BadgeSuccessBg}" CornerRadius="6" Padding="10,6">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BadgeSuccessFg}">
                            <Run Text="Önerilen Aktif: " />
                            <Run Text="{Binding RecommendedActiveCount, Mode=OneWay}" />
                            <Run Text=" / " />
                            <Run Text="{Binding RecommendedCount, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Preset Action Bar (ShutUp10++ style Actions) -->
            <WrapPanel Margin="0,0,0,14">
                <Button Content="Sadece Önerilenleri Uygula"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ApplyRecommendedPackCommand}"
                        Margin="0,0,8,8" />
                <Button Content="Önerilen + Kısmen Önerilen"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ApplyRecommendedPlusPartialCommand}"
                        Margin="0,0,8,8" />
                <Button Content="Geri Yükleme Noktası Oluştur"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CreateRestorePointCommand}"
                        Margin="0,0,8,8" />
                <Button Content="Explorer'ı Yeniden Başlat"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RestartExplorerCommand}"
                        Margin="0,0,8,8" />
            </WrapPanel>

            <!-- Search & Category Filter -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Ayar ara (telemetri, edge, sağ tık, recall...)"
                         Margin="0,0,10,0" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding SelectedFilter}" />
            </Grid>

            <!-- Tweak Cards -->
            <ItemsControl ItemsSource="{Binding FilteredTweaks}" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MatteCard}" Padding="16,13" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />

                                        <!-- Önerilen Badge (Matte Green) -->
                                        <Border Background="{StaticResource BadgeSuccessBg}"
                                                CornerRadius="4"
                                                Padding="7,2"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding RecommendationLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BadgeSuccessFg}" />
                                        </Border>

                                        <!-- Kısmen Önerilen Badge (Matte Amber) -->
                                        <Border Background="{StaticResource BadgeWarningBg}"
                                                CornerRadius="4"
                                                Padding="7,2"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsPartiallyRecommended, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding RecommendationLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BadgeWarningFg}" />
                                        </Border>

                                        <Border Background="{StaticResource BadgeNeutralBg}" CornerRadius="4" Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourceTag}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" />
                                        </Border>
                                        <Border Background="{StaticResource BadgeNeutralBg}" CornerRadius="4" Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StateLabel}" FontSize="10.5" Foreground="{StaticResource TextPrimary}" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                              Command="{Binding DataContext.ToggleTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              Visibility="{Binding IsOneShotAction, Converter={StaticResource InvBoolToVis}}" />

                                    <Button Content="{Binding ActionButtonText}"
                                            Style="{StaticResource DangerButton}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                            Command="{Binding DataContext.OneShotTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsOneShotAction, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Built-in Bloatware AppX Remover -->
            <Border Style="{StaticResource MatteCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Ön Yüklü Microsoft Bloatware Uygulamaları" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="Format sonrası gereksiz gelen yerleşik mağaza uygulamalarını seçip sistemden temizleyin." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Listeyi Yenile" Style="{StaticResource SecondaryButton}" Command="{Binding ScanBloatwareCommand}" Margin="0,0,8,0" />
                            <Button Content="Seçilenleri Kaldır" Style="{StaticResource DangerButton}" Command="{Binding RemoveSelectedBloatwareCommand}" />
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding BloatwareApps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0E0E12"
                                        BorderBrush="{StaticResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,9"
                                        Margin="0,0,8,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium" />
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
