<UserControl x:Class="LRXCore.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Gereksiz Dosya &amp; Önbellek Temizleyici" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Önerilenleri Seç" Style="{StaticResource SecondaryButton}" Command="{Binding SelectRecommendedCommand}" Margin="0,0,8,0" />
                <Button Content="Tara" Style="{StaticResource SecondaryButton}" Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                <Button Content="Seçilenleri Temizle" Style="{StaticResource PrimaryButton}" Command="{Binding CleanSelectedCommand}" />
            </StackPanel>
        </Grid>

        <!-- Main TabControl mirroring reference layout in Pure Matte Black -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <!-- Tab 1: Ortak Temizleyici -->
            <TabItem Header="Ortak Temizleyici">
                <Border Background="#0D0D10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="0,8,8,8" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="410" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Checklist Panel (like screenshot) -->
                        <Border Background="#111115" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="4,2,4,10">
                                    <TextBlock Text="Taranacak alanı seçin" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                                    <Button DockPanel.Dock="Right"
                                            Content="Tümünü Seç"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding SelectAllCommonCommand}"
                                            Padding="8,3"
                                            FontSize="11"
                                            HorizontalAlignment="Right" />
                                </DockPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Windows Group -->
                                        <TextBlock Text="Windows" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="4,2,0,6" />
                                        <ItemsControl ItemsSource="{Binding WindowsCommonCategories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#15151A" CornerRadius="5" Padding="8,6" Margin="0,0,4,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" FontFamily="{StaticResource IconFont}" Text="{Binding IconGlyph}" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="4,0,8,0" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Tarayıcı Group -->
                                        <TextBlock Text="Tarayıcı" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="4,12,0,6" />
                                        <ItemsControl ItemsSource="{Binding BrowserCommonCategories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#15151A" CornerRadius="5" Padding="8,6" Margin="0,0,4,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" FontFamily="{StaticResource IconFont}" Text="{Binding IconGlyph}" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="4,0,8,0" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Right Summary, Recommendations & Custom Folders -->
                        <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Scan Summary Banner -->
                                <Border Style="{StaticResource MatteCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ScanSummaryTitle}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ScanSummaryDetail}" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Recommended Junk Items -->
                                <Border Style="{StaticResource MatteCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="Önerilen Çöp &amp; Yüksek Boyutlu Kalıntılar" Style="{StaticResource SectionHeader}" />
                                            <Border DockPanel.Dock="Right" Background="{StaticResource BadgeWarningBg}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="Temizlenmesi Önerilir" FontSize="11" Foreground="{StaticResource BadgeWarningFg}" />
                                            </Border>
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding RecommendedCategories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0E0E12" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding DetailDisplay}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Background="{StaticResource BadgeNeutralBg}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SizeDisplay}" FontSize="12" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Tarama yapıldıktan sonra yüksek yer kaplayan güvenli çöp kategorileri burada listelenir."
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Visibility="{Binding HasScanned, Converter={StaticResource InvBoolToVis}}" />
                                    </StackPanel>
                                </Border>

                                <!-- Custom Folders Configuration -->
                                <Border Style="{StaticResource MatteCard}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Özel Temizlik Klasörleri ('Özel' seçeneği)" Style="{StaticResource SectionHeader}" />
                                                <TextBlock Text="Eklediğiniz klasörlerin içeriği 'Özel Klasörler' işaretliyken temizlenir." FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                            </StackPanel>
                                            <Button DockPanel.Dock="Right" Content="Klasör Ekle" Style="{StaticResource SecondaryButton}" Command="{Binding AddCustomFolderCommand}" HorizontalAlignment="Right" Padding="10,6" />
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding CustomFolders}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0E0E12" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,0,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <Button Grid.Column="1"
                                                                    Content="Kaldır"
                                                                    Style="{StaticResource SecondaryButton}"
                                                                    Command="{Binding DataContext.RemoveCustomFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="8,3"
                                                                    FontSize="11" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 2: Gelişmiş Temizleyici -->
            <TabItem Header="Gelişmiş Temizleyici">
                <Border Background="#0D0D10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="0,8,8,8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- App & GPU Shader Caches -->
                        <Border Style="{StaticResource MatteCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Gelişmiş Uygulama &amp; GPU Shader Önbellekleri" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding AdvancedCategories}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0E0E12" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,8,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" FontSize="12" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Large File Finder (>500MB) -->
                        <Border Grid.Row="1" Style="{StaticResource MatteCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Büyük Dosya Bulucu (&gt;500 MB)" Style="{StaticResource SectionHeader}" />
                                        <TextBlock Text="İndirilenler, Masaüstü, Belgeler ve Videolar altındaki unutulmuş büyük dosyaları bulup önerir." FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Büyük Dosyaları Tara" Style="{StaticResource SecondaryButton}" Command="{Binding ScanLargeFilesCommand}" Margin="0,0,8,0" />
                                        <Button Content="Seçilen Dosyaları Sil" Style="{StaticResource DangerButton}" Command="{Binding DeleteSelectedLargeFilesCommand}" />
                                    </StackPanel>
                                </DockPanel>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding LargeFiles}" IsReadOnly="False">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                                        <DataGridTextColumn Header="Dosya Adı" Binding="{Binding FileName}" Width="1.4*" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Konum" Binding="{Binding FolderPath}" Width="2*" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Boyut" Binding="{Binding SizeDisplay}" Width="105" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
