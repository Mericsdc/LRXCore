<UserControl x:Class="LRXCore.Views.InstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Format Sonrası Toplu Uygulama Kurulumu" Style="{StaticResource PageTitle}" />
                <TextBlock Text="İstediğiniz uygulamaları işaretleyin; LRX Core hepsini Winget üzerinden sessizce indirip kursun." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BadgeNeutralBg}" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}">
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" />
                        <Run Text=" seçili" />
                    </TextBlock>
                </Border>
                <Button Content="Seçilenleri Kur"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartInstallCommand}"
                        Visibility="{Binding IsInstalling, Converter={StaticResource InvBoolToVis}}" />
                <Button Content="İptal Et"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding CancelInstallCommand}"
                        Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>

        <!-- Search + Filters + Profile actions -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Uygulama veya Winget ID ara..."
                     Margin="0,0,10,0" />

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}"
                      Margin="0,0,10,0" />

            <WrapPanel Grid.Column="2" HorizontalAlignment="Right">
                <Button Content="Önerilenler" Style="{StaticResource SecondaryButton}" Command="{Binding SelectRecommendedCommand}" Margin="0,0,6,0" Padding="10,7" />
                <Button Content="Tümünü Seç" Style="{StaticResource SecondaryButton}" Command="{Binding SelectAllVisibleCommand}" Margin="0,0,6,0" Padding="10,7" />
                <Button Content="Temizle" Style="{StaticResource SecondaryButton}" Command="{Binding ClearAllCommand}" Margin="0,0,6,0" Padding="10,7" />
                <Button Content="Profil Kaydet" Style="{StaticResource SecondaryButton}" Command="{Binding SaveProfileCommand}" Margin="0,0,6,0" Padding="10,7" />
                <Button Content="Profil Yükle" Style="{StaticResource SecondaryButton}" Command="{Binding LoadProfileCommand}" Padding="10,7" />
            </WrapPanel>
        </Grid>

        <!-- Custom Winget ID adder -->
        <Border Grid.Row="2" Style="{StaticResource MatteCard}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Özel Paket Ekle" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock Grid.Column="1" Text="Winget ID:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Grid.Column="2" Text="{Binding CustomWingetId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Örn: VideoLAN.VLC" Margin="0,0,12,0" />
                <TextBlock Grid.Column="3" Text="Uygulama Adı:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Grid.Column="4" Text="{Binding CustomAppName, UpdateSourceTrigger=PropertyChanged}" ToolTip="İsteğe bağlı görünen ad" Margin="0,0,10,0" />
                <Button Grid.Column="5" Content="Listeye Ekle" Style="{StaticResource SecondaryButton}" Command="{Binding AddCustomAppCommand}" Padding="12,7" />
            </Grid>
        </Border>

        <!-- Apps Checklist -->
        <Border Grid.Row="3" Background="#0D0D10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredApps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#121216"
                                    BorderBrush="#1F1F26"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <Border Grid.Column="1" Width="34" Height="34" Background="#1A1A20" CornerRadius="6" Margin="0,0,12,0">
                                        <TextBlock FontFamily="{StaticResource IconFont}"
                                                   Text="{Binding IconGlyph}"
                                                   FontSize="15"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                            <Border Background="{StaticResource BadgeNeutralBg}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0">
                                            <Run Text="{Binding Description, Mode=OneWay}" />
                                            <Run Text="  •  " Foreground="{StaticResource TextMuted}" />
                                            <Run Text="{Binding Id, Mode=OneWay}" Foreground="{StaticResource TextMuted}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Border Grid.Column="3"
                                            Background="#18181F"
                                            BorderBrush="{StaticResource BorderSubtle}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Progress & Log Footer -->
        <Border Grid.Row="4" Style="{StaticResource MatteCard}" Padding="14" Margin="0,12,0,0">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding CurrentInstallText}" FontSize="12.5" FontWeight="Medium" />
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextSecondary}">
                        <Run Text="{Binding ProgressPercent, StringFormat=F0, Mode=OneWay}" />
                        <Run Text="%" />
                    </TextBlock>
                </DockPanel>
                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Margin="0,0,0,8" />
                <TextBox Text="{Binding ConsoleLog, Mode=OneWay}"
                         IsReadOnly="True"
                         Height="80"
                         FontFamily="Consolas"
                         FontSize="11.5"
                         Foreground="{StaticResource TextSecondary}"
                         VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Visibility="{Binding ConsoleLog, Converter={StaticResource StrToVis}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
