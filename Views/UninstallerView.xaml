<UserControl x:Class="LRXCore.Views.UninstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Derin Program Kaldırıcı (HiBit Tarzı)" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Listeyi Yenile"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Sadece Artık Tara"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ScanLeftoversOnlyCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Kaldır &amp; Artıkları Tara"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding UninstallAndScanCommand}" />
            </StackPanel>
        </Grid>

        <!-- Search & Filter Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Program veya yayıncı adı ara..." />

            <CheckBox Grid.Column="1"
                      Content="Sistem bileşenlerini ve gizli girdileri de göster"
                      IsChecked="{Binding IncludeSystemComponents}"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center" />

            <Border Grid.Column="2" Background="{StaticResource BadgeNeutralBg}" CornerRadius="6" Padding="10,6">
                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}">
                    <Run Text="Yüklü: " />
                    <Run Text="{Binding TotalAppsCount, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                </TextBlock>
            </Border>
        </Grid>

        <!-- Installed Apps Grid + Optional Leftover Drawer -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding FilteredApps}"
                      SelectedItem="{Binding SelectedApp}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Uygulama Adı" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Yayıncı" Binding="{Binding Publisher}" Width="1.2*" />
                    <DataGridTextColumn Header="Sürüm" Binding="{Binding Version}" Width="110" />
                    <DataGridTextColumn Header="Boyut" Binding="{Binding SizeDisplay}" Width="95" />
                    <DataGridTextColumn Header="Tür" Binding="{Binding TypeLabel}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Leftover Review Panel -->
            <Border Grid.Column="1"
                    Width="440"
                    Margin="14,0,0,0"
                    Style="{StaticResource MatteCard}"
                    Padding="16"
                    Visibility="{Binding IsLeftoverPanelOpen, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding LeftoverHeader}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Width="350" />
                        <Button DockPanel.Dock="Right" Content="X" Style="{StaticResource SecondaryButton}" Command="{Binding CloseLeftoverPanelCommand}" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Sadece Güvenli Seç" Style="{StaticResource SecondaryButton}" Command="{Binding SelectSafeLeftoversCommand}" Padding="10,5" FontSize="11.5" Margin="0,0,6,0" />
                        <Button Content="Tümünü Seç" Style="{StaticResource SecondaryButton}" Command="{Binding SelectAllLeftoversCommand}" Padding="10,5" FontSize="11.5" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Leftovers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0E0E12"
                                            BorderBrush="{StaticResource BorderSubtle}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                            <StackPanel Grid.Column="1">
                                                <WrapPanel Margin="0,0,0,3">
                                                    <Border Background="{StaticResource BadgeNeutralBg}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding TypeLabel}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" />
                                                    </Border>
                                                    <Border Background="{StaticResource BadgeWarningBg}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding RiskLabel}" FontSize="10.5" Foreground="{StaticResource BadgeWarningFg}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding SizeDisplay}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Path}" FontSize="11.5" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding LocationCategory}" FontSize="10.5" Foreground="{StaticResource TextMuted}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="3"
                            Content="Seçilen Çöp &amp; Kalıntıları Temizle"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding CleanLeftoversCommand}"
                            Margin="0,12,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Hint -->
        <TextBlock Grid.Row="3"
                   Text="İpucu: Bir programın kendi kaldırıcısı başarısız olursa veya zaten yarım silinmişse 'Sadece Artık Tara' ile kalan dosya ve kayıt defteri girdilerini temizleyebilirsiniz."
                   FontSize="11.5"
                   Foreground="{StaticResource TextMuted}"
                   Margin="0,10,0,0" />
    </Grid>
</UserControl>
