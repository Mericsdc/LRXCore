<UserControl x:Class="LRXCore.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Sistem &amp; Donanım Özeti" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Donanımı Yenile"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- Quick Actions -->
            <WrapPanel Margin="0,0,0,18">
                <Button Content="Toplu Uygulama Kurulumuna Git"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Installer"
                        Margin="0,0,10,8" />
                <Button Content="Win11 Ayarları &amp; OneDrive Kaldır"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Tweaks"
                        Margin="0,0,10,8" />
                <Button Content="Gereksiz Dosya Temizleyici"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Cleaner"
                        Margin="0,0,10,8" />
                <Button Content="Derin Program Kaldırıcı"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Uninstaller"
                        Margin="0,0,10,8" />
            </WrapPanel>

            <!-- 4 Hardware Cards -->
            <UniformGrid Columns="2" Margin="0,0,0,16">
                <!-- CPU Card -->
                <Border Style="{StaticResource MatteCard}" Margin="0,0,8,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE950;" FontSize="15" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="İŞLEMCİ (CPU)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Hardware.CpuName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource BadgeNeutralBg}" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock FontSize="11.5" Foreground="{StaticResource BadgeNeutralFg}">
                                    <Run Text="{Binding Hardware.CpuCores, Mode=OneWay}" />
                                    <Run Text=" Çekirdek / " />
                                    <Run Text="{Binding Hardware.CpuThreads, Mode=OneWay}" />
                                    <Run Text=" İzlek" />
                                </TextBlock>
                            </Border>
                            <Border Background="{StaticResource BadgeNeutralBg}" CornerRadius="4" Padding="8,3">
                                <TextBlock FontSize="11.5" Foreground="{StaticResource BadgeNeutralFg}">
                                    <Run Text="{Binding Hardware.CpuMaxClockMhz, Mode=OneWay}" />
                                    <Run Text=" MHz" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- GPU Card -->
                <Border Style="{StaticResource MatteCard}" Margin="8,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7F4;" FontSize="15" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="EKRAN KARTI (GPU)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Gpus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border Background="{StaticResource BadgeNeutralBg}" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                                <TextBlock FontSize="11.5" Foreground="{StaticResource BadgeNeutralFg}" Text="{Binding VramDisplay}" />
                                            </Border>
                                            <Border Background="{StaticResource BadgeNeutralBg}" CornerRadius="4" Padding="8,3">
                                                <TextBlock FontSize="11.5" Foreground="{StaticResource BadgeNeutralFg}">
                                                    <Run Text="Sürücü: " />
                                                    <Run Text="{Binding DriverVersion, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- RAM & Motherboard Card -->
                <Border Style="{StaticResource MatteCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE964;" FontSize="15" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="BELLEK &amp; ANAKART" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Hardware.RamDisplay}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap">
                            <Run Text="Anakart: " />
                            <Run Text="{Binding Hardware.MotherboardName, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- OS Card -->
                <Border Style="{StaticResource MatteCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE770;" FontSize="15" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="İŞLETİM SİSTEMİ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Hardware.OsCaption}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondary}">
                            <Run Text="Cihaz: " />
                            <Run Text="{Binding Hardware.ComputerName, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" />
                            <Run Text="  •  Yapı: " />
                            <Run Text="{Binding Hardware.OsBuild, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Disks Section -->
            <Border Style="{StaticResource MatteCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Depolama Sürücüleri" Style="{StaticResource SectionHeader}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Disks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock FontSize="13" FontWeight="Medium">
                                            <Run Text="{Binding DriveLetter, Mode=OneWay}" />
                                            <Run Text=" (" Foreground="{StaticResource TextSecondary}" />
                                            <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" />
                                            <Run Text=")" Foreground="{StaticResource TextSecondary}" />
                                        </TextBlock>
                                        <TextBlock DockPanel.Dock="Right"
                                                   HorizontalAlignment="Right"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Text="{Binding SummaryDisplay}" />
                                    </DockPanel>
                                    <ProgressBar Grid.Row="1" Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="5" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Smart Driver & Runtime Recommendations -->
            <Border Style="{StaticResource MatteCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Donanıma Özel Sürücü &amp; Altyapı Önerileri" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="Tespit edilen CPU ve GPU'nuza göre format sonrası kurulması önerilen bileşenler" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Recommendations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0E0E12"
                                        BorderBrush="{StaticResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Reason}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="{Binding ActionLabel}"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.ExecuteRecommendationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
