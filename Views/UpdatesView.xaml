<UserControl x:Class="LRXCore.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Uygulama Güncelleme Takipçisi" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Güncellemeleri Tara" Style="{StaticResource SecondaryButton}" Command="{Binding ScanUpdatesCommand}" Margin="0,0,8,0" />
                <Button Content="Tümünü Güncelle" Style="{StaticResource PrimaryButton}" Command="{Binding UpdateAllCommand}" />
            </StackPanel>
        </Grid>

        <!-- LRX Core Self-Update Card (GitHub Releases) -->
        <Border Grid.Row="1" Style="{StaticResource MatteCard}" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LRX Core Uygulama Güncellemesi" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="{StaticResource BadgeNeutralBg}" CornerRadius="4" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentAppVersion}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            </Border>
                            <Border Background="{StaticResource BadgeNeutralBg}" CornerRadius="4" Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="GitHub: Mericsdc/LRXCore" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding SelfUpdateStatus}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="LRX Core Sürümünü Kontrol Et"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CheckSelfUpdateCommand}"
                                IsEnabled="{Binding IsSelfUpdating, Converter={StaticResource InverseBool}}"
                                Margin="0,0,8,0" />
                        <Button Content="Güncellemeyi İndir &amp; Kur"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding InstallSelfUpdateCommand}"
                                Visibility="{Binding IsSelfUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                IsEnabled="{Binding IsSelfUpdating, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </Grid>
                <ProgressBar Value="{Binding SelfUpdateProgress, Mode=OneWay}"
                             Maximum="100"
                             Margin="0,10,0,0"
                             Visibility="{Binding IsSelfUpdating, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- Outdated Apps Grid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Updates}" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                <DataGridTextColumn Header="Uygulama" Binding="{Binding Name}" Width="1.6*" IsReadOnly="True" />
                <DataGridTextColumn Header="Winget ID" Binding="{Binding WingetId}" Width="1.3*" IsReadOnly="True" />
                <DataGridTextColumn Header="Mevcut Sürüm" Binding="{Binding CurrentVersion}" Width="130" IsReadOnly="True" />
                <DataGridTextColumn Header="Yeni Sürüm" Binding="{Binding AvailableVersion}" Width="130" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Durum" Width="145">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{StaticResource TextSecondary}"
                                           Visibility="{Binding IsUpdated, Converter={StaticResource InvBoolToVis}}" />
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsUpdated, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontFamily="{StaticResource IconFont}"
                                               Text="&#xE73E;"
                                               FontSize="12"
                                               Foreground="{StaticResource BadgeSuccessFg}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="Güncellendi"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BadgeSuccessFg}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="İşlem" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center">
                                <Button Content="{Binding ActionButtonText}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,4"
                                        FontSize="11.5"
                                        IsEnabled="{Binding CanUpdate}"
                                        Visibility="{Binding IsUpdated, Converter={StaticResource InvBoolToVis}}"
                                        Command="{Binding DataContext.UpdateSingleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />

                                <Border Background="{StaticResource BadgeSuccessBg}"
                                        BorderBrush="#1F3D2B"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="10,4"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding IsUpdated, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}"
                                                   Text="&#xE73E;"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BadgeSuccessFg}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0" />
                                        <TextBlock Text="Güncellendi"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BadgeSuccessFg}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Progress & Log -->
        <Border Grid.Row="3" Style="{StaticResource MatteCard}" Padding="14" Margin="0,12,0,0">
            <StackPanel>
                <ProgressBar IsIndeterminate="True" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="Arka plan bildirimleri Ayarlar sekmesinden özelleştirilebilir. Güncelleme geldiğinde LRX Core Windows bildirimi ile size sorar."
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}" />
                <TextBox Text="{Binding UpdateLog, Mode=OneWay}"
                         IsReadOnly="True"
                         Height="80"
                         Margin="0,8,0,0"
                         FontFamily="Consolas"
                         FontSize="11.5"
                         Foreground="{StaticResource TextSecondary}"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         Visibility="{Binding UpdateLog, Converter={StaticResource StrToVis}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
