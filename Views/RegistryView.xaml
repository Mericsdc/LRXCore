<UserControl x:Class="LRXCore.Views.RegistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Güvenli Kayıt Defteri Temizleyici" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BadgeSuccessBg}" CornerRadius="5" Padding="10,6" Margin="0,0,10,0">
                    <TextBlock Text="Otomatik .REG Yedek Korumalı" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BadgeSuccessFg}" />
                </Border>
                <Button Content="Kayıt Defterini Tara" Style="{StaticResource SecondaryButton}" Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                <Button Content="Yedekle &amp; Temizle" Style="{StaticResource PrimaryButton}" Command="{Binding CleanCommand}" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1">
            <!-- Subtab 1: Tarama & Temizlik -->
            <TabItem Header="Tarama &amp; Sorunlar">
                <Border Background="#0D0D10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="0,8,8,8" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Categories -->
                        <Border Style="{StaticResource MatteCard}" Padding="14" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="Güvenli Tarama Kategorileri" Style="{StaticResource SectionHeader}" Margin="0,0,0,12" />
                                <CheckBox Content="Geçersiz Kaldırma Kayıtları" IsChecked="{Binding ScanUninstall}" Margin="0,0,0,10" />
                                <CheckBox Content="Bozuk Başlangıç (Run) Girdileri" IsChecked="{Binding ScanStartup}" Margin="0,0,0,10" />
                                <CheckBox Content="Eksik Paylaşılan DLL'ler" IsChecked="{Binding ScanSharedDlls}" Margin="0,0,0,10" />
                                <CheckBox Content="Geçersiz Uygulama Yolları" IsChecked="{Binding ScanAppPaths}" Margin="0,0,0,10" />
                                <CheckBox Content="MUI Önbellek Artıkları" IsChecked="{Binding ScanMuiCache}" Margin="0,0,0,10" />
                                <CheckBox Content="Silinmiş Güvenlik Duvarı Kuralları" IsChecked="{Binding ScanFirewall}" Margin="0,0,0,16" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Tümünü Seç" Style="{StaticResource SecondaryButton}" Command="{Binding SelectAllCommand}" Padding="10,6" FontSize="12" Margin="0,0,6,0" />
                                    <Button Content="Bırak" Style="{StaticResource SecondaryButton}" Command="{Binding ClearAllCommand}" Padding="10,6" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Found Issues -->
                        <DataGrid Grid.Column="1" ItemsSource="{Binding Issues}" IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                                <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="180" IsReadOnly="True" />
                                <DataGridTextColumn Header="Kayıt Yolu / Değer" Binding="{Binding FullPath}" Width="1.6*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Neden Önerildi" Binding="{Binding Reason}" Width="1.4*" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Subtab 2: Yedekler & Geri Yükle -->
            <TabItem Header="Yedekler &amp; Geri Yükle">
                <Border Background="#0D0D10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="0,8,8,8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Temizlenen kayıtların tümü otomatik .reg dosyası olarak saklanır; tek tıkla geri yükleyebilirsiniz." FontSize="12.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="Yedekleri Yenile" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshBackupsCommand}" HorizontalAlignment="Right" />
                        </DockPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Backups}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Yedek Dosyası" Binding="{Binding FileName}" Width="2*" />
                                <DataGridTextColumn Header="Oluşturulma Tarihi" Binding="{Binding DateDisplay}" Width="170" />
                                <DataGridTextColumn Header="Boyut" Binding="{Binding SizeDisplay}" Width="100" />
                                <DataGridTemplateColumn Header="İşlem" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Geri Yükle"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="10,4"
                                                    FontSize="11.5"
                                                    Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
