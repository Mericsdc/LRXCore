<UserControl x:Class="LRXCore.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Güvenli Hizmet Optimizasyonu (Uyut &amp; Yönet)" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Yenile" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="Son Yedeği Geri Yükle" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreSnapshotCommand}" Margin="0,0,8,0" />
                <Button Content="Önerilen Aksiyonu Uygula" Style="{StaticResource SecondaryButton}" Command="{Binding ApplyRecommendedCommand}" Margin="0,0,8,0" />
                <Button Content="Seçilenleri Uyut (Elle)" Style="{StaticResource PrimaryButton}" Command="{Binding SleepSelectedCommand}" />
            </StackPanel>
        </Grid>

        <!-- Safety Notice Banner -->
        <Border Grid.Row="1" Background="#111116" BorderBrush="#282834" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <Border Background="{StaticResource BadgeSuccessBg}" CornerRadius="4" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="Çökme Korumalı" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BadgeSuccessFg}" />
                </Border>
                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap">
                    Hiçbir Windows hizmeti silinmez. Çekirdek ağ, ses, ekran kartı, güvenlik ve Windows Update servisleri kilitlidir.
                    'Uyut (Elle)' sadece gereksiz servislerin arka planda otomatik açılmasını durdurur ve işlem öncesi JSON yedeği alır.
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Filter & Stats Bar -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Hizmet adı veya açıklama ara..." Margin="0,0,10,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}" Margin="0,0,10,0" />
            <Button Grid.Column="2" Content="Güvenlileri Seç" Style="{StaticResource SecondaryButton}" Command="{Binding SelectSafeOnlyCommand}" Padding="12,7" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="{StaticResource BadgeNeutralBg}" CornerRadius="5" Padding="9,4" Margin="0,0,8,0">
                    <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondary}">
                        <Run Text="Aday: " />
                        <Run Text="{Binding TotalCount, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                    </TextBlock>
                </Border>
                <Border Background="{StaticResource BadgeWarningBg}" CornerRadius="5" Padding="9,4" Margin="0,0,8,0">
                    <TextBlock FontSize="11.5" Foreground="{StaticResource BadgeWarningFg}">
                        <Run Text="Optimize Edilebilir: " />
                        <Run Text="{Binding RunningOptimizableCount, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </Border>
                <Border Background="{StaticResource BadgeSuccessBg}" CornerRadius="5" Padding="9,4">
                    <TextBlock FontSize="11.5" Foreground="{StaticResource BadgeSuccessFg}">
                        <Run Text="Uyuyor / Optimize: " />
                        <Run Text="{Binding OptimizedCount, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Services List -->
        <Border Grid.Row="3" Background="#0D0D10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredServices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#111116" BorderBrush="#21212A" BorderThickness="1" CornerRadius="6" Padding="14,11" Margin="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                        <WrapPanel Margin="0,0,0,4">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ServiceName, StringFormat=' ({0})'}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />

                                            <Border Background="{StaticResource BadgeSuccessBg}" CornerRadius="4" Padding="7,2" Margin="8,0,0,0" Visibility="{Binding IsSafeTier, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding TierLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BadgeSuccessFg}" />
                                            </Border>
                                            <Border Background="{StaticResource BadgeWarningBg}" CornerRadius="4" Padding="7,2" Margin="8,0,0,0" Visibility="{Binding IsOptionalTier, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding TierLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BadgeWarningFg}" />
                                            </Border>
                                            <Border Background="{StaticResource BadgeNeutralBg}" CornerRadius="4" Padding="7,2" Margin="8,0,0,0" Visibility="{Binding IsThirdPartyTier, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding TierLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                                            </Border>
                                        </WrapPanel>

                                        <TextBlock Text="{Binding Explanation}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ImpactNote}" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                                            <Border Background="{StaticResource BadgeNeutralBg}" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding StateDisplay}" FontSize="11" Foreground="{StaticResource TextPrimary}" />
                                            </Border>
                                            <Border Background="{StaticResource BadgeNeutralBg}" CornerRadius="4" Padding="7,3">
                                                <TextBlock Text="{Binding StartModeDisplay}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding RecommendedActionLabel, StringFormat='Öneri: {0}'}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMuted}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <ProgressBar Grid.Row="4" IsIndeterminate="True" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
